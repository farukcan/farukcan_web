---
// Cloudflare Pages (and local preview) serve this for unknown paths.
// Map /$x → /#$x so deep links land on the matching hash section.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Redirecting…</title>
    <script is:inline>
      (function () {
        var path = location.pathname.replace(/^\/+|\/+$/g, "");
        var search = location.search;
        if (path && path.indexOf(".") === -1) {
          if (path === "games") {
            location.replace("/?no-contact-info=yes#projects");
            return;
          }
          location.replace("/" + search + "#" + path);
          return;
        }
        location.replace("/" + search);
      })();
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0;url=/" />
    </noscript>
  </head>
  <body>
    <noscript><a href="/">Continue to home</a></noscript>
  </body>
</html>
