---
import { Image } from "astro:assets";
import type { Project } from "../lib/data";

interface Props {
  project: Project;
  /** Hide on first paint (e.g. beyond the initial page size). */
  initiallyHidden?: boolean;
}
const { project, initiallyHidden = false } = Astro.props;

const tagNames = project.tags.map((t) => t.name).join(",");
const dialogId = `project-dialog-${project.id}`;
const formattedDate = formatProjectDate(project.date);

// Grid: 1 col mobile, 2 from sm, 3 from lg (max-w-6xl ≈ 1152px).
const coverSizes = "(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw";

/** Format Notion date (YYYY-MM-DD) without UTC day-shift. */
function formatProjectDate(iso: string | null): string | null {
  if (!iso) return null;
  const [y, m, d] = iso.slice(0, 10).split("-").map(Number);
  if (!y || !m) return iso;
  return new Date(y, m - 1, d || 1).toLocaleDateString("en-GB", {
    year: "numeric",
    month: "short",
    day: d ? "numeric" : undefined,
  });
}
---

{/* `contents` keeps the card in the parent grid; closed <dialog> does not take a cell. */}
<div class="contents">
  <article
    class="project-card reveal glass group relative flex flex-col overflow-hidden rounded-3xl transition-all duration-500 hover:-translate-y-1.5 hover:border-apple-blue/40"
    data-tags={tagNames}
    data-status={project.status}
    style={initiallyHidden ? "display: none" : undefined}
  >
    <button
      type="button"
      class="absolute inset-0 z-10 cursor-pointer rounded-3xl"
      data-project-open={dialogId}
      aria-haspopup="dialog"
      aria-controls={dialogId}
      aria-label={`Open project ${project.name}`}
    >
    </button>

    <div class="relative aspect-video overflow-hidden bg-apple-dark">
      {
        project.cover ? (
          <Image
            src={project.cover}
            alt={project.name}
            width={640}
            height={360}
            sizes={coverSizes}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
        ) : (
          <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-apple-dark to-black">
            <span class="font-hand text-4xl text-white/20">{project.name}</span>
          </div>
        )
      }
      {
        project.status && (
          <span
            class="pointer-events-none absolute right-3 top-3 z-20 rounded-full px-3 py-1 text-xs font-medium text-white backdrop-blur"
            style={`background:${project.statusColor}cc`}
          >
            {project.status}
          </span>
        )
      }
    </div>

    <div class="flex flex-1 flex-col p-6">
      <div class="mb-2 flex items-center gap-2">
        {
          project.icon && (
            <Image
              src={project.icon}
              alt=""
              width={24}
              height={24}
              loading="lazy"
              decoding="async"
              class="h-6 w-6 rounded object-contain"
            />
          )
        }
        <h3 class="text-lg font-semibold text-apple-light">{project.name}</h3>
      </div>

      {
        project.description && (
          <p class="mb-4 line-clamp-2 text-sm leading-relaxed text-apple-gray">
            {project.description}
          </p>
        )
      }

      <div class="mt-auto flex flex-wrap gap-2 pt-2">
        {
          project.tags.map((t) => (
            <span
              class="rounded-full px-2.5 py-1 text-xs font-medium"
              style={`background:${t.color}22;color:${t.color}`}
            >
              {t.name}
            </span>
          ))
        }
      </div>
    </div>
  </article>

  <dialog
    id={dialogId}
    class="project-dialog m-auto w-[min(100%,40rem)] max-h-[min(90vh,52rem)] flex-col overflow-hidden rounded-3xl border border-white/10 bg-[#1c1c1e] p-0 text-apple-light shadow-2xl"
    aria-labelledby={`${dialogId}-title`}
  >
    <div
      class="flex shrink-0 items-start justify-between gap-4 border-b border-white/10 px-5 py-4 sm:px-6"
    >
      <div class="min-w-0 flex items-center gap-3">
        {
          project.icon && (
            <Image
              src={project.icon}
              alt=""
              width={32}
              height={32}
              loading="lazy"
              decoding="async"
              class="h-8 w-8 shrink-0 rounded object-contain"
            />
          )
        }
        <div class="min-w-0">
          <h2
            id={`${dialogId}-title`}
            class="truncate text-lg font-semibold tracking-tight"
          >
            {project.name}
          </h2>
          {
            (project.status || formattedDate) && (
              <p class="mt-0.5 truncate text-xs text-apple-gray">
                {[project.status, formattedDate].filter(Boolean).join(" · ")}
              </p>
            )
          }
        </div>
      </div>
      <div class="flex shrink-0 items-center gap-2">
        {
          project.link && (
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary !px-4 !py-1.5 text-sm"
            >
              Open Link
            </a>
          )
        }
        <button
          type="button"
          class="project-dialog-close rounded-full border border-white/10 px-3 py-1.5 text-sm text-apple-gray transition-colors hover:border-white/20 hover:text-apple-light"
          aria-label={`Close ${project.name}`}
          data-project-close
        >
          Close
        </button>
      </div>
    </div>

    <div class="min-h-0 flex-1 overflow-y-auto px-5 py-5 sm:px-6">
      {
        project.cover && (
          <Image
            src={project.cover}
            alt=""
            width={1200}
            height={1200}
            fit="inside"
            sizes="(max-width: 640px) 100vw, 40rem"
            loading="lazy"
            decoding="async"
            class="mb-5 h-auto w-full rounded-2xl"
          />
        )
      }
      {
        project.tags.length > 0 && (
          <div class="mb-5 flex flex-wrap gap-2">
            {project.tags.map((t) => (
              <span
                class="rounded-full px-2.5 py-1 text-xs font-medium"
                style={`background:${t.color}22;color:${t.color}`}
              >
                {t.name}
              </span>
            ))}
          </div>
        )
      }
      {
        project.parsedContent ? (
          <div class="prose-notion prose-notion-modal" set:html={project.parsedContent} />
        ) : (
          project.description && (
            <p class="text-sm leading-relaxed text-apple-gray">
              {project.description}
            </p>
          )
        )
      }
    </div>
  </dialog>
</div>
