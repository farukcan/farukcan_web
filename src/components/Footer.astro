---
import type { SiteData } from "../lib/data";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
const buildDate = new Date(data.generatedAt).toLocaleDateString("en-GB");
---

<!-- z-10 keeps it above the pinned hero layer (see index.astro). -->
<footer class="hairline relative z-10 bg-apple-black py-12">
  <div
    data-reveal
    class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-6 text-sm text-apple-gray sm:flex-row"
  >
    <p>{data.footer}</p>
    <div data-contact class="flex items-center gap-5">
      {
        data.socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-apple-light"
          >
            {s.label}
          </a>
        ))
      }
    </div>
    <p data-contact-hidden-msg class="text-sm text-apple-gray/70">
      Contact Info is hidden
    </p>
  </div>
  <p class="mt-6 text-center text-xs text-apple-gray/50">
    Built with ❤️ {buildDate}
  </p>
</footer>
