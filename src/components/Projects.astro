---
import type { SiteData } from "../lib/data";
import FeaturedProjects from "./FeaturedProjects.astro";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;

const filters = ["All", ...data.categories];
const PAGE_SIZE = 21;
const initialRemaining = Math.max(0, data.projects.length - PAGE_SIZE);
---

<section id="projects" class="hairline relative py-32">
  <FeaturedProjects data={data} />

  <div id="project-archive" class="mx-auto max-w-6xl px-6">
    <div class="mb-14">
      <p
        data-reveal
        class="flex items-center gap-3 font-hand text-2xl text-apple-blue"
      >
        Archive
      </p>
      <h2
        data-split="words"
        class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl"
      >
        {data.projects.length} Projects
      </h2>
    </div>

    <!-- Filter chips -->
    <div id="project-filters" data-reveal class="mb-10 flex flex-wrap gap-2">
      {
        filters.map((f, i) => (
          <button
            class:list={[
              "filter-btn rounded-full border px-4 py-2 text-sm font-medium transition-colors",
              i === 0
                ? "border-apple-blue bg-apple-blue text-white"
                : "border-white/10 text-apple-gray hover:text-apple-light",
            ]}
            data-filter={f}
          >
            {f}
          </button>
        ))
      }
    </div>

    <div
      id="project-grid"
      data-reveal-group
      class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        data.projects.map((p, i) => (
          <ProjectCard project={p} initiallyHidden={i >= PAGE_SIZE} />
        ))
      }
    </div>

    <div id="load-more-wrap" class="mt-10 flex justify-center">
      <button
        id="load-more-btn"
        type="button"
        data-magnetic
        class:list={[
          "btn-ghost border-apple-green px-10 py-4 text-base",
          initialRemaining <= 0 && "hidden",
        ]}
        aria-controls="project-grid"
        aria-expanded="false"
      >
        {
          initialRemaining > 0
            ? `Load More ${initialRemaining} Projects`
            : "Load More"
        }
      </button>
    </div>
  </div>
</section>

<script>
  const PAGE_SIZE = 21;

  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const cards = document.querySelectorAll<HTMLElement>(".project-card");
  const loadMoreBtn =
    document.querySelector<HTMLButtonElement>("#load-more-btn");

  const activeCls = ["border-apple-blue", "bg-apple-blue", "text-white"];
  const idleCls = ["border-white/10", "text-apple-gray"];

  let currentFilter = "All";
  let expanded = false;

  function matchingCards(filter: string): HTMLElement[] {
    return Array.from(cards).filter((card) => {
      const tags = (card.dataset.tags ?? "").split(",");
      return filter === "All" || tags.includes(filter);
    });
  }

  function notifyMotion() {
    window.dispatchEvent(new Event("motion:refresh"));
  }

  function applyVisibility() {
    const matched = matchingCards(currentFilter);
    const limit = expanded ? matched.length : PAGE_SIZE;

    cards.forEach((card) => {
      card.style.display = "none";
    });
    matched.forEach((card, i) => {
      card.style.display = i < limit ? "" : "none";
    });

    if (!loadMoreBtn) return;

    const remaining = matched.length - PAGE_SIZE;
    if (!expanded && remaining > 0) {
      loadMoreBtn.textContent = `Load More ${remaining} Projects`;
      loadMoreBtn.classList.remove("hidden");
      loadMoreBtn.setAttribute("aria-expanded", "false");
    } else {
      loadMoreBtn.classList.add("hidden");
      loadMoreBtn.setAttribute("aria-expanded", expanded ? "true" : "false");
    }

    notifyMotion();
  }

  function setActive(btn: HTMLButtonElement) {
    buttons.forEach((b) => {
      b.classList.remove(...activeCls);
      b.classList.add(...idleCls);
    });
    btn.classList.remove(...idleCls);
    btn.classList.add(...activeCls);
  }

  function selectFilter(btn: HTMLButtonElement) {
    currentFilter = btn.dataset.filter ?? "All";
    expanded = false;
    setActive(btn);
    applyVisibility();
  }

  /** Compare hash fragments and tag names independent of case and punctuation. */
  function normalizeKey(value: string): string {
    return value
      .trim()
      .toLowerCase()
      .normalize("NFKD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/\+\+/g, "plusplus")
      .replace(/#/g, "sharp")
      .replace(/\+/g, "plus")
      .replace(/&/g, " and ")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
  }

  const pageSections = new Set([
    "hero",
    "services",
    "projects",
    "about",
    "skills",
    "contact",
  ]);

  function hashFragment(): string {
    const raw = location.hash.replace(/^#/, "").trim();
    if (!raw) return "";
    try {
      return decodeURIComponent(raw);
    } catch {
      return raw;
    }
  }

  /** Real in-page anchors keep native / Lenis scrolling and do not change the tab. */
  function isNativeAnchor(fragment: string): boolean {
    if (pageSections.has(normalizeKey(fragment))) return true;
    return document.getElementById(fragment) != null;
  }

  function findFilterButton(fragment: string): HTMLButtonElement | null {
    const key = normalizeKey(fragment);
    if (!key) return null;

    const aliases = new Set<string>([key]);
    if (key.endsWith("s") && key.length > 3) aliases.add(key.slice(0, -1));
    else if (!key.endsWith("s") && key.length >= 3) aliases.add(`${key}s`);

    let match: HTMLButtonElement | null = null;
    let score = 0;
    buttons.forEach((btn) => {
      const filterKey = normalizeKey(btn.dataset.filter ?? "");
      if (!filterKey || !aliases.has(filterKey)) return;
      const next = filterKey === key ? 2 : 1;
      if (next > score) {
        match = btn;
        score = next;
      }
    });
    return match;
  }

  let pendingImmediate: boolean | null = null;
  let motionWait: { timer: number; finish: () => void } | null = null;

  function cancelPendingScroll() {
    if (!motionWait) return;
    window.clearTimeout(motionWait.timer);
    window.removeEventListener("motion:ready", motionWait.finish);
    motionWait = null;
    pendingImmediate = null;
  }

  function scrollToProjects(immediate: boolean) {
    // Land on the archive, past the pinned featured scroller.
    const native = () => {
      document.getElementById("project-archive")?.scrollIntoView({ block: "start" });
    };

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      cancelPendingScroll();
      native();
      return;
    }

    const dispatch = (instant: boolean) => {
      if (document.documentElement.dataset.motionReady == null) {
        native();
        return;
      }
      window.dispatchEvent(
        new CustomEvent("motion:scroll-to", {
          detail: { id: "project-archive", immediate: instant },
        }),
      );
    };

    if (document.documentElement.dataset.motionReady != null) {
      cancelPendingScroll();
      dispatch(immediate);
      return;
    }

    pendingImmediate = immediate;
    if (motionWait) return;

    const finish = () => {
      if (!motionWait) return;
      window.clearTimeout(motionWait.timer);
      window.removeEventListener("motion:ready", motionWait.finish);
      motionWait = null;
      const instant = pendingImmediate ?? false;
      pendingImmediate = null;
      dispatch(instant);
    };

    motionWait = { timer: window.setTimeout(finish, 2500), finish };
    window.addEventListener("motion:ready", finish, { once: true });
  }

  function applyHashFilter(immediate: boolean): boolean {
    const fragment = hashFragment();
    if (!fragment || isNativeAnchor(fragment)) {
      cancelPendingScroll();
      return false;
    }
    const btn = findFilterButton(fragment);
    if (!btn) {
      cancelPendingScroll();
      return false;
    }
    selectFilter(btn);
    scrollToProjects(immediate);
    return true;
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      selectFilter(btn);
    });
  });

  loadMoreBtn?.addEventListener("click", () => {
    expanded = true;
    applyVisibility();
  });

  if (!applyHashFilter(true)) applyVisibility();

  window.addEventListener("hashchange", () => {
    applyHashFilter(true);
  });

  // Project detail modal (native <dialog>). Featured cards share these ids.
  document
    .querySelectorAll<HTMLElement>("[data-project-open]")
    .forEach((el) => {
      el.addEventListener("click", () => {
        const id = el.dataset.projectOpen;
        if (!id) return;
        const dialog = document.getElementById(id);
        if (dialog instanceof HTMLDialogElement) {
          dialog.showModal();
          window.dispatchEvent(new Event("motion:lock"));
        }
      });
    });

  function unlockMotion() {
    window.dispatchEvent(new Event("motion:unlock"));
  }

  document
    .querySelectorAll<HTMLDialogElement>(".project-dialog")
    .forEach((dialog) => {
      const close = () => {
        dialog.close();
        unlockMotion();
      };

      dialog
        .querySelectorAll<HTMLElement>("[data-project-close]")
        .forEach((btn) => btn.addEventListener("click", close));

      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) close();
      });
      dialog.addEventListener("close", unlockMotion);
      dialog.addEventListener("cancel", unlockMotion);
    });
</script>
