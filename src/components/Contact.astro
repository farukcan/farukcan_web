---
import type { SiteData } from "../lib/data";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
---

<section id="contact" data-contact class="hairline relative overflow-hidden py-32">
  <!-- Parallax glow; centered with margins because GSAP owns the transform. -->
  <div
    data-parallax="-160"
    class="pointer-events-none absolute left-1/2 top-1/2 -z-10 -ml-40 -mt-40 h-80 w-80 will-change-transform"
    aria-hidden="true"
  >
    <div
      class="animate-pulseGlow h-full w-full rounded-full bg-apple-blue/15 blur-[120px]"
    >
    </div>
  </div>

  <div class="mx-auto max-w-3xl px-6 text-center">
    <SectionHeading
      index={5}
      eyebrow="Get in touch"
      title="Let's build something together"
      align="center"
      class="!mb-0"
    />
    <p data-reveal class="mx-auto mt-5 max-w-xl text-lg text-apple-gray">
      Available for freelance projects, consulting and collaborations. Reach me
      on any of the platforms below.
    </p>

    <div data-reveal-group class="mt-10 flex flex-wrap justify-center gap-3">
      {
        data.socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            data-reveal
            data-magnetic
            class="glass rounded-full px-5 py-3 text-sm font-medium text-apple-light transition-[border-color] hover:border-apple-blue/40"
          >
            {s.label}
          </a>
        ))
      }
    </div>
  </div>
</section>
