---
import type { SiteData } from "../lib/data";
import ServiceCard from "./ServiceCard.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
const { title, description, hideTitle, items } = data.services;
---

<section id="services" class="hairline relative py-32">
  <div class="mx-auto max-w-6xl px-6">
    {
      !hideTitle && (
        <SectionHeading index={1} eyebrow="What I do" title={title} align="center">
          {description && (
            <p
              data-reveal
              class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-apple-gray sm:text-lg"
            >
              {description}
            </p>
          )}
        </SectionHeading>
      )
    }

    <div
      data-reveal-group
      class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"
    >
      {items.map((s) => <ServiceCard service={s} />)}
    </div>
  </div>
</section>
