---
import type { SiteData } from "../lib/data";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;

const ROW_COUNT = 3;

/** Deterministic shuffle so SSR output is stable across builds. */
function shuffle<T>(items: T[], seed: number): T[] {
  const arr = [...items];
  let s = seed >>> 0;
  for (let i = arr.length - 1; i > 0; i--) {
    s = (Math.imul(s, 1664525) + 1013904223) >>> 0;
    const j = s % (i + 1);
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}

// Per-row order, direction, speed, and phase — looks random, stays build-stable.
const rows = Array.from({ length: ROW_COUNT }, (_, row) => {
  let tags = shuffle(data.techTags, 0x9e3779b9 + row * 2654435761);
  // Pad just enough to fill wide viewports without bloating the DOM.
  while (tags.length > 0 && tags.length < 10) tags = [...tags, ...tags];
  return {
    // Two identical halves for a seamless -50% loop.
    tags: [...tags, ...tags],
    reverse: row % 2 === 1,
    // Staggered durations (seconds) — slower base so motion stays calm.
    duration: 55 + ((row * 13 + 7) % 25),
    // Phase offset so rows don't start aligned.
    delay: -((row * 11) % 23),
  };
});
---

<!-- About / marquee -->
<section id="about" class="relative border-t border-white/5 py-28">
  <div class="mx-auto max-w-5xl px-6">
    <p class="reveal font-hand text-2xl text-apple-blue">What I do</p>
    <h2
      class="reveal mt-2 max-w-3xl text-3xl font-bold tracking-tight sm:text-4xl"
    >
      {data.description}
    </h2>
  </div>

  <!--
    No .reveal / .glass here:
    - reveal transform fights marquee translate
    - glass backdrop-filter on moving pills causes jank
  -->
  <div
    class="relative mt-16 overflow-hidden py-2 [mask-image:linear-gradient(to_right,transparent,black_20%,black_80%,transparent)]"
  >
    <div class="flex flex-col gap-3">
      {
        rows.map((row) => (
          <div
            class:list={[
              "flex w-max gap-3 transform-gpu will-change-transform backface-hidden",
              row.reverse ? "animate-marqueeReverse" : "animate-marquee",
            ]}
            style={`animation-duration:${row.duration}s;animation-delay:${row.delay}s`}
          >
            {row.tags.map((t) => (
              <span class="whitespace-nowrap rounded-full border border-white/10 bg-apple-dark/90 px-5 py-2 text-sm text-apple-gray">
                {t}
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- Skill sections -->
<section id="skills" class="relative border-t border-white/5 py-28">
  <div class="mx-auto max-w-5xl px-6">
    <div class="reveal mb-14">
      <p class="font-hand text-2xl text-apple-blue">Expertise</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">
        Skills & Services
      </h2>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {
        data.skills.map((s) => (
          <div class="reveal glass group rounded-3xl p-8 transition-all duration-500 hover:-translate-y-1 hover:border-apple-blue/40">
            <h3 class="mb-4 text-xl font-semibold text-apple-light">
              {s.title}
            </h3>
            <div class="prose-notion" set:html={s.bodyHtml} />
          </div>
        ))
      }
    </div>
  </div>
</section>
