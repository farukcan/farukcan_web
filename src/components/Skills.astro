---
import type { SiteData } from "../lib/data";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;

const ROW_COUNT = 3;

/** Deterministic shuffle so SSR output is stable across builds. */
function shuffle<T>(items: T[], seed: number): T[] {
  const arr = [...items];
  let s = seed >>> 0;
  for (let i = arr.length - 1; i > 0; i--) {
    s = (Math.imul(s, 1664525) + 1013904223) >>> 0;
    const j = s % (i + 1);
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}

// Per-row order, direction, speed, and phase — looks random, stays build-stable.
const rows = Array.from({ length: ROW_COUNT }, (_, row) => {
  let tags = shuffle(data.techTags, 0x9e3779b9 + row * 2654435761);
  // Pad just enough to fill wide viewports without bloating the DOM.
  while (tags.length > 0 && tags.length < 10) tags = [...tags, ...tags];
  return {
    // Two identical halves for a seamless -50% loop.
    tags: [...tags, ...tags],
    direction: row % 2 === 1 ? -1 : 1,
    // Staggered durations (seconds) — slower base so motion stays calm.
    duration: 55 + ((row * 13 + 7) % 25),
    // Phase offset (0..1) so rows don't start aligned.
    phase: ((row * 11) % 23) / 23,
  };
});
---

<!-- About / marquee -->
<section id="about" class="hairline relative py-32">
  <div class="mx-auto max-w-5xl px-6">
    <p
      data-reveal
      class="mb-5 flex items-center gap-3 font-hand text-2xl text-apple-blue"
    >
      <span
        class="font-sans text-[11px] font-medium tracking-[0.3em] text-apple-gray/70"
        >03</span
      >
      <span class="h-px w-6 bg-apple-blue/40" aria-hidden="true"></span>
      About
    </p>
    <h2
      data-split="words"
      class="max-w-4xl text-3xl font-bold leading-[1.12] tracking-tight sm:text-4xl lg:text-5xl"
    >
      {data.description}
    </h2>
  </div>

  <!--
    No glass here: backdrop-filter on constantly moving pills causes jank.
    Rows are driven by marquee.ts (speed and direction react to scroll velocity).
  -->
  <div
    class="relative mt-16 overflow-hidden py-2 [mask-image:linear-gradient(to_right,transparent,black_20%,black_80%,transparent)]"
  >
    <div class="flex flex-col gap-3">
      {
        rows.map((row) => (
          <div
            data-marquee
            data-direction={row.direction}
            data-duration={row.duration}
            data-phase={row.phase}
            class="flex w-max gap-3 transform-gpu will-change-transform backface-hidden"
          >
            {row.tags.map((t) => (
              <span class="whitespace-nowrap rounded-full border border-white/10 bg-apple-dark/90 px-5 py-2 text-sm text-apple-gray">
                {t}
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- Skill sections -->
<section id="skills" class="hairline relative py-32">
  <div class="mx-auto max-w-5xl px-6">
    <SectionHeading index={4} eyebrow="Expertise" title="Skills" />

    <div data-reveal-group class="grid gap-6 md:grid-cols-2">
      {
        data.skills.map((s) => (
          <div
            data-reveal
            data-tilt
            class="glass group relative overflow-hidden rounded-3xl p-8 transition-[border-color] duration-500 hover:border-apple-blue/40"
          >
            <h3 class="mb-4 text-xl font-semibold text-apple-light">
              {s.title}
            </h3>
            <div class="prose-notion" set:html={s.bodyHtml} />
          </div>
        ))
      }
    </div>
  </div>
</section>
