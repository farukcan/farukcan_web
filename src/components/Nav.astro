---
interface Props {
  name: string;
}
const { name } = Astro.props;

const links = [
  { href: "#projects", label: "Projects" },
  { href: "#about", label: "About" },
  { href: "#skills", label: "Skills" },
  { href: "#contact", label: "Contact" },
];
---

<header class="fixed inset-x-0 top-0 z-50 px-4 pt-4">
  <nav
    class="glass mx-auto flex max-w-5xl items-center justify-between rounded-full px-6 py-3"
  >
    <a href="#hero" class="text-lg font-semibold tracking-tight">
      {name}<span class="text-apple-blue">.</span>
    </a>
    <ul class="hidden items-center gap-8 text-sm text-apple-gray md:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="transition-colors hover:text-apple-light">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href="#contact" class="btn-primary !px-5 !py-2 text-xs">Get in touch</a>
  </nav>
</header>
