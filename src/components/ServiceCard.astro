---
import type { Service } from "../lib/data";
import NotionIcon from "./NotionIcon.astro";
import { resolveNotionIconAccent } from "../lib/notionIcons";

interface Props {
  service: Service;
}
const { service } = Astro.props;

const accent = resolveNotionIconAccent(service.iconName, service.iconColor);
---

<article
  class="reveal glass group flex flex-col rounded-2xl p-7 transition-all duration-500 hover:-translate-y-1.5 hover:border-white/20"
>
  <div
    class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl transition-transform duration-500 group-hover:scale-110"
    style={`background:${accent}22`}
    aria-hidden="true"
  >
    <NotionIcon name={service.iconName} color={service.iconColor} size="md" />
  </div>

  <h3 class="mb-2 text-lg font-semibold tracking-tight text-apple-light">
    {service.name}
  </h3>

  {
    service.description && (
      <p class="text-sm leading-relaxed text-apple-gray">
        {service.description}
      </p>
    )
  }
</article>
