---
import type { Service } from "../lib/data";
import {
  resolveServiceIconAccent,
  serviceIconPaths,
} from "../lib/notionIcons";

interface Props {
  service: Service;
}
const { service } = Astro.props;

const accent = resolveServiceIconAccent(service.iconName, service.iconColor);
const paths = serviceIconPaths(service.iconName);
---

<article
  class="reveal glass group flex flex-col rounded-2xl p-7 transition-all duration-500 hover:-translate-y-1.5 hover:border-white/20"
>
  <div
    class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl transition-transform duration-500 group-hover:scale-110"
    style={`background:${accent}22;color:${accent}`}
    aria-hidden="true"
  >
    <svg
      class="h-5 w-5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      viewBox="0 0 24 24"
    >
      {paths.map((d) => <path d={d} />)}
    </svg>
  </div>

  <h3 class="mb-2 text-lg font-semibold tracking-tight text-apple-light">
    {service.name}
  </h3>

  {
    service.description && (
      <p class="text-sm leading-relaxed text-apple-gray">
        {service.description}
      </p>
    )
  }
</article>
