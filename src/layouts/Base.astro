---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  siteName: string;
  siteUrl: string;
  twitterUsername?: string;
}

const { title, description, siteName, siteUrl, twitterUsername } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL("/logo.png", siteUrl).href;
const twitterHandle = twitterUsername
  ? twitterUsername.replace(/^@/, "")
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteName} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={siteName} />
    {
      twitterHandle && (
        <>
          <meta name="twitter:site" content={`@${twitterHandle}`} />
          <meta name="twitter:creator" content={`@${twitterHandle}`} />
        </>
      )
    }
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script is:inline>
      // Hide contact UI before paint when ?no-contact-info=yes
      if (
        new URLSearchParams(location.search).get("no-contact-info") === "yes"
      ) {
        document.documentElement.dataset.noContactInfo = "";
      }
    </script>
  </head>
  <body
    class="bg-apple-black font-sans text-apple-light antialiased selection:bg-apple-blue/30 selection:text-white"
  >
    <slot />
    <script>
      // Scroll-reveal on intersection.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
