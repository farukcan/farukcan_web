---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  siteName: string;
  siteUrl: string;
  twitterUsername?: string;
}

const { title, description, siteName, siteUrl, twitterUsername } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL("/og.png", siteUrl).href;
const twitterHandle = twitterUsername
  ? twitterUsername.replace(/^@/, "")
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteName} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={siteName} />
    {
      twitterHandle && (
        <>
          <meta name="twitter:site" content={`@${twitterHandle}`} />
          <meta name="twitter:creator" content={`@${twitterHandle}`} />
        </>
      )
    }
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script
      defer
      src="https://umami.puhulab.com/script.js"
      data-website-id="c633b1b2-ac35-45de-b8f7-5d7f6371ff22"
      data-domains="farukcan.dev,www.farukcan.dev,old.farukcan.dev"
      is:inline></script>
    <script is:inline>
      document.documentElement.classList.add("js");
      // Hide contact UI before paint when ?no-contact-info=yes
      if (
        new URLSearchParams(location.search).get("no-contact-info") === "yes"
      ) {
        document.documentElement.dataset.noContactInfo = "";
      }
    </script>
  </head>
  <body
    class="bg-apple-black font-sans text-apple-light antialiased selection:bg-apple-blue/30 selection:text-white"
  >
    <slot />
    <script>
      // Scroll-reveal on intersection.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
    <script>
      // Track every <a> / <button> click via Umami (JS API — avoids data-umami-event
      // swallowing other click listeners on filter / load-more controls).
      type UmamiTracker = {
        track: (
          eventName: string,
          eventData?: Record<string, string | number | boolean>,
        ) => void;
      };

      function getClickLabel(el: HTMLElement): string {
        const aria = el.getAttribute("aria-label")?.trim();
        if (aria) return aria;

        const filter = el.dataset.filter?.trim();
        if (filter) return filter;

        if (el.id) return el.id;

        const heading = el.querySelector("h3")?.textContent?.trim();
        if (heading) return heading;

        const text = el.innerText?.trim().replace(/\s+/g, " ");
        if (text) return text.slice(0, 40);

        if (el instanceof HTMLAnchorElement) {
          return el.getAttribute("href") || "link";
        }
        return "button";
      }

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const el = target.closest("a, button");
        if (
          !(el instanceof HTMLAnchorElement || el instanceof HTMLButtonElement)
        ) {
          return;
        }
        if (el instanceof HTMLButtonElement && el.disabled) return;

        const umami = (window as Window & { umami?: UmamiTracker }).umami;
        if (!umami?.track) return;

        const tag = el.tagName.toLowerCase();
        const label = getClickLabel(el);
        const href =
          el instanceof HTMLAnchorElement
            ? (el.getAttribute("href") ?? "")
            : "";
        const name = `${tag}: ${label}`.slice(0, 50);

        const data: Record<string, string> = { tag, label: label.slice(0, 100) };
        if (href) data.href = href.slice(0, 500);
        if (el.id) data.id = el.id;
        if (el.dataset.filter) data.filter = el.dataset.filter;

        umami.track(name, data);
      });
    </script>
  </body>
</html>
